// for Comprehensions
// for Loops
// src/main/scala/progscala3/rounding/basic_for.worksheet

for
  i <- 0 until 10
do println(i)

for i <- 0 until 10
  do println(i)

for i <- 0 until 10 do println(i)

// The original Scala 2 syntax 

for (i <- 0 until 10)
  println(i)

for (i <- 0 until 10) println(i)  

